Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%labels
    Description "Safe Agent Actuation course environment for OpenPI, MuJoCo, and SST"
    OpenPICommit "15a9616a00943ada6c20a0f158e3adb39df2ccac"
    SSTCommit "1a40ebece054880e4fe400c1c5880b05ac91ad79"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libegl1 \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libglvnd0 \
        libosmesa6 \
        make \
        maven \
        nodejs \
        npm \
        openjdk-17-jdk-headless \
        openssl \
        pkg-config \
        unzip \
        zip
    rm -rf /var/lib/apt/lists/*

    curl -LsSf https://astral.sh/uv/0.8.13/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    UV_PYTHON_INSTALL_DIR=/opt/uv-python uv python install 3.11

%environment
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export UV_CACHE_DIR=/tmp/uv-cache
    export PATH=/usr/local/bin:$PATH

%runscript
    echo "Bind the repository and scratch, then run make setup and make doctor."
    echo "Model weights are staged separately with make model-setup."

