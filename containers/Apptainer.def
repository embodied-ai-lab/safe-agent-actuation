Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

%labels
    Description "Safe Agent Actuation course environment for OpenPI, MuJoCo, and SST"
    OpenPICommit "15a9616a00943ada6c20a0f158e3adb39df2ccac"
    SSTCommit "1a40ebece054880e4fe400c1c5880b05ac91ad79"

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        libegl1 \
        libgl1 \
        libgl1-mesa-dri \
        libglib2.0-0 \
        libglvnd0 \
        libosmesa6 \
        make \
        maven \
        openjdk-17-jdk-headless \
        openssl \
        pkg-config \
        unzip \
        xz-utils \
        zip
    rm -rf /var/lib/apt/lists/*

    # Ubuntu 22.04's Node 12 cannot run IoTAuth's credential generator.
    # Use the official Node 22 binary (including npm) for Sol's x86-64 nodes.
    # Checksum source: https://nodejs.org/dist/v22.23.3/SHASUMS256.txt
    curl -fL https://nodejs.org/dist/v22.23.3/node-v22.23.3-linux-x64.tar.xz \
        -o /tmp/node.tar.xz
    echo "df450af89261115ef9f9e3830c3eeb2cc9213b63c720b1af623cb5dcbe2e02de  /tmp/node.tar.xz" \
        | sha256sum -c -
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1
    rm /tmp/node.tar.xz

    curl -LsSf https://astral.sh/uv/0.8.13/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    UV_PYTHON_INSTALL_DIR=/opt/uv-python uv python install 3.11
    # uv's default executable directory is /root/.local/bin, which is not
    # available to students. Expose the managed interpreter on the image PATH.
    ln -s "$(UV_PYTHON_INSTALL_DIR=/opt/uv-python uv python find 3.11)" /usr/local/bin/python3.11
    ln -s python3.11 /usr/local/bin/python3

%environment
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export UV_PYTHON_INSTALL_DIR=/opt/uv-python
    export UV_CACHE_DIR=/tmp/uv-cache
    export PATH=/usr/local/bin:$PATH

%test
    set -eu
    python3.11 -c 'import sys; assert sys.version_info[:2] == (3, 11)'
    python3 -c 'import sys; assert sys.version_info[:2] == (3, 11)'
    node -e "require('node:assert').strictEqual(typeof require('node:fs').rmSync, 'function')"
    node --version
    npm --version
    uv --version

%runscript
    echo "Bind the repository and scratch, then run make setup and make doctor."
    echo "The graded workflow uses committed captures and fixtures; no model download is required."

