      "tcpPort": 22900,
      "udpPort": 22902,
      "authPort": 22901,
      "callbackPort": 22903,
      "dbProtectionMethod": 1,
      "backupEnabled": false,
      "contextualCallbackEnabled": false
    }
  ],
  "authTrusts": [],
